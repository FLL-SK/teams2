{
  "name": "teams2",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=26",
    "pnpm": ">=12"
  },
  "scripts": {
    "start": "pnpm start:server",
    "start:server": "node dist/apps/server/main.js",
    "start:dev": "pnpm run \"/^dev:(server|client)$/\"",
    "dev:server": "tsx watch --clear-screen=false --tsconfig apps/server/tsconfig.app.json apps/server/src/main.ts",
    "dev:client": "vite --config apps/client/vite.config.mts",
    "preview:client": "vite preview --config apps/client/vite.config.mts",
    "build": "pnpm build:all",
    "build:all": "pnpm generate && pnpm compile",
    "build:client": "pnpm generate && pnpm compile:client",
    "build:server": "pnpm generate && pnpm compile:server",
    "compile": "pnpm compile:server && pnpm compile:client",
    "compile:client": "vite build --config apps/client/vite.config.mts",
    "compile:server": "node scripts/build-server.mjs",
    "generate": "pnpm gql:schema && pnpm gql:codegen",
    "gql:codegen": "graphql-codegen --config codegen.ts",
    "gql:schema": "tsx --tsconfig tsconfig.base.json ./scripts/build-schema.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config apps/server/vitest.integration.config.mts",
    "e2e": "playwright test -c apps/client-e2e/playwright.config.ts",
    "lint": "eslint .",
    "typecheck": "node scripts/typecheck.mjs",
    "format": "prettier --write .",
    "testseed": "tsx --tsconfig apps/server/tsconfig.app.json apps/server/src/main.ts testseed"
  },
  "dependencies": {
    "@apollo/server": "^5.5.2",
    "@as-integrations/express5": "^1.1.2",
    "@aws-sdk/client-s3": "^3.1178.0",
    "@aws-sdk/client-ses": "^3.1178.0",
    "@aws-sdk/s3-request-presigner": "^3.1178.0",
    "@date-fns/tz": "^1.5.0",
    "@graphql-tools/graphql-file-loader": "^9.1.3",
    "@graphql-tools/load": "^9.1.4",
    "@graphql-tools/schema": "^11.0.10",
    "@graphql-tools/utils": "^13.2.3",
    "axios": "^1.21.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dataloader": "^2.2.3",
    "date-fns": "^4.4.0",
    "debug": "^4.4.3",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "8.7.3",
    "flat": "^6.0.1",
    "graphql": "^16.15.0",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.18.1",
    "mongodb": "^7.9.1",
    "mongoose": "^9.13.1",
    "morgan": "^1.12.1",
    "omit-deep": "^0.3.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.18.9/xlsx-0.18.9.tgz",
    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "@apollo/client": "^4.3.8",
    "@eslint/js": "^9.39.5",
    "@graphql-codegen/add": "^8.0.0",
    "@graphql-codegen/cli": "^8.0.0",
    "@graphql-codegen/introspection": "^7.0.0",
    "@graphql-codegen/typescript": "^7.0.1",
    "@graphql-codegen/typescript-operations": "^7.0.2",
    "@graphql-codegen/typescript-react-apollo": "^6.0.1",
    "@graphql-codegen/typescript-resolvers": "^7.0.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/cors": "^2.8.19",
    "@types/debug": "^4.1.13",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.27",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.10",
    "@types/omit-deep": "^0.3.2",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.2",
    "@types/passport-local": "^1.0.38",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/yargs": "^17.0.35",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "grommet": "^2.59.0",
    "grommet-icons": "^4.14.0",
    "jsdom": "^31.0.1",
    "markdown-to-jsx": "^9.11.0",
    "mongodb-memory-server-core": "^11.4.0",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.3",
    "react-virtualized": "^10.0.1",
    "react-virtualized-auto-sizer": "^2.0.4",
    "rxjs": "^7.8.2",
    "styled-components": "^6.7.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
