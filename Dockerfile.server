# Description: Dockerfile for server

FROM node:26-slim

# Node 25+ už neobsahuje corepack – pnpm sa inštaluje cez npm (verzia podľa package.json)
RUN npm install -g pnpm@12.23.0 && npm cache clean --force

RUN mkdir -p /server

WORKDIR /server

# copy project package files and pnpm configuration
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# install production dependencies only
RUN pnpm install --prod --frozen-lockfile && pnpm store prune

# copy server files
COPY dist/apps/server .
COPY dist/schema.graphql .

# expose port 3000
EXPOSE 3000

# making sure container starts from the right folder
WORKDIR /server

# run server
ENTRYPOINT ["node", "main.js"]
