{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "sourceMap": true,
    "declaration": false,
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": [],
    "strict": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@teams2/auth-node": ["./libs/auth-node/src/index.ts"],
      "@teams2/auth-react": ["./libs/auth-react/src/index.ts"],
      "@teams2/common": ["./libs/common/src/index.ts"],
      "@teams2/dateutils": ["./libs/dateutils/src/index.ts"],
      "@teams2/logger": ["./libs/logger/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp", "dist"]
}
